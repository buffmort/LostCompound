# ============================================================
# 构建输出
# ============================================================
# 这两个模式不带前导斜杠，所以匹配任意层级的 bin/ obj/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# 发布产物（自包含 exe 体积大，不入库）
publish/

# ============================================================
# IDE / 编辑器
# ============================================================
# JetBrains Rider
.idea/
*.sln.DotSettings.user
*.DotSettings.user

# Visual Studio
.vs/
*.user
*.suo
*.userprefs

# VS Code
.vscode/

# ============================================================
# .NET / NuGet
# ============================================================
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/
packages/
*.binlog

# ============================================================
# 操作系统
# ============================================================
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
*~

# ============================================================
# 本项目自己的临时/工具文件
# ============================================================
# 桌面快捷方式（二进制，且路径是本机的绝对路径，换台机器就没用）
*.lnk

# 用来渲染 TUI 截图的验证脚本（开发时的临时工具，不是游戏的一部分）
RenderScreen.ps1
RenderProbe.ps1

# 临时文件
*.tmp
*.log
